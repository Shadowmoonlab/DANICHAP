{
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:css": "tailwindcss -i tailwind-input.css -o tailwind.css --minify",
    "watch:css": "tailwindcss -i tailwind-input.css -o tailwind.css --watch",
    "dev": "node dev/start.mjs",
    "dev:reset": "node dev/start.mjs --reset",
    "dev:robot:dm": "node --env-file=.dev/supabase.env --env-file-if-exists=.env.local scrapers/dm.mjs",
    "dev:robot:pr": "node --env-file=.dev/supabase.env --env-file-if-exists=.env.local scrapers/pr.mjs",
    "test:robots": "node dev/prueba-robots.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.102.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "embedded-postgres": "17.10.0-beta.17",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^3.4.19"
  }
}
