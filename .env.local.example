# Copiá este archivo como .env.local y completalo para correr los robots CONTRA LA BASE LOCAL:
#   npm run dev:robot:dm     npm run dev:robot:pr
# (SUPABASE_URL y SUPABASE_SERVICE_KEY locales los pone solo "npm run dev" en .dev/supabase.env)
DM_EMAIL=
DM_PASSWORD=
PR_USER=
PR_PASSWORD=

# Lectura de facturas con IA en el ambiente local (opcional). En producción va como secreto
# de la Edge Function:  supabase secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=
